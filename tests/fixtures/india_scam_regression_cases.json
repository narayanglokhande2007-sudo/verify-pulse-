{
  "suite": "VerifyPulse India-focused regression cases",
  "version": "1.0.0",
  "dataHandling": "All entries are synthetic, non-live test fixtures. They must never be added to production threat feeds, blocklists, dashboards, or marketing metrics.",
  "cases": [
    {
      "id": "digital-arrest-authority-impersonation",
      "classification": "synthetic-scam",
      "input": "CBI Cyber Crime wing: Aapke Aadhaar se illegal bank accounts link mile hain. FIR close karne ke liye 30 minutes ke andar video verification call join karein aur apna ID proof WhatsApp karein. Kisi ko batana mana hai.",
      "checkType": "unified",
      "expectedVerdict": "SUSPICIOUS",
      "expectedEvidenceSource": "Local social-engineering rules"
    },
    {
      "id": "upi-collect-request-pressure",
      "classification": "synthetic-scam",
      "input": "Dear Customer, RBI compliance ke under aapka account 6 PM par debit freeze ho jayega. Re-KYC ke liye Rs. 2 verification collect request approve karein. OTP/PIN share nahi karna hai.",
      "checkType": "unified",
      "expectedVerdict": "SUSPICIOUS",
      "expectedEvidenceSource": "Local social-engineering rules"
    },
    {
      "id": "income-tax-verification-call",
      "classification": "synthetic-scam",
      "input": "Income Tax Department: Refund processing ke liye bank account details verify karni hain. Is message ka reply YES karein; aapko secure verification call aayega.",
      "checkType": "unified",
      "expectedVerdict": "SUSPICIOUS",
      "expectedEvidenceSource": "Local social-engineering rules"
    },
    {
      "id": "legitimate-anti-fraud-advisory",
      "classification": "synthetic-benign-advisory",
      "input": "Security alert: Never share your UPI PIN, OTP, CVV or screen-sharing code with anyone. To report financial cyber fraud in India, call 1930 or use the National Cyber Crime Reporting Portal.",
      "checkType": "unified",
      "expectedVerdict": "SAFE",
      "expectedEvidenceSource": null
    },
    {
      "id": "actual-otp-protection",
      "classification": "synthetic-sensitive-input",
      "input": "My OTP is 123456.",
      "checkType": "unified",
      "expectedVerdict": "CAUTION",
      "expectedEvidenceSource": "Privacy guard"
    },
    {
      "id": "official-rbi-url",
      "classification": "benign-public-url",
      "input": "https://www.rbi.org.in/",
      "checkType": "unified",
      "expectedVerdict": "SAFE",
      "expectedEvidenceSource": "Trusted domain registry"
    },
    {
      "id": "safe-browsing-known-malicious-fixture",
      "classification": "synthetic-url-reputation-match",
      "input": "https://rbi-kyc.example/verify",
      "checkType": "unified",
      "expectedVerdict": "DANGEROUS",
      "expectedEvidenceSource": "Google Safe Browsing"
    },
    {
      "id": "file-analysis-consent-required",
      "classification": "synthetic-privacy-control",
      "input": "Analyze this uploaded image for scam indicators.",
      "checkType": "unified",
      "fileData": {
        "mimeType": "image/png",
        "base64": "c3ludGhldGljLXRlc3QtZml4dHVyZQ=="
      },
      "expectedHttpStatus": 400,
      "expectedVerdict": "CONSENT_REQUIRED",
      "expectedEvidenceSource": "Privacy guard"
    }
  ]
}
